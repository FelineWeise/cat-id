# Copy to production.env on the server (gitignored). Do not commit secrets.
#
# Image pin: prefer the tracked non-secret file image.env (updated by CI on main).
# On the server, apply with:
#   docker compose --env-file production.env --env-file image.env pull && \
#   docker compose --env-file production.env --env-file image.env up -d
# Do not put CAT_ID_IMAGE here once image.env is in use (image.env is loaded last and must win).
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
LASTFM_API_KEY=your_lastfm_api_key_here
APP_ENV=production
APP_BASE_URL=https://app.cat-id.eu
SPOTIFY_REDIRECT_URI=https://app.cat-id.eu/api/spotify/callback
ALLOWED_ORIGINS=https://app.cat-id.eu
ENABLE_DEBUG_ENDPOINT=false
PORT=8000
